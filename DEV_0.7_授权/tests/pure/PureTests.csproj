<Project Sdk="Microsoft.NET.Sdk">
  <!--
    脱离天工 CAD 的纯逻辑测试，Mac / Linux / Windows 上都能跑：
      在本目录执行 dotnet run
    只编译不引用 CAD / WinForms 类型的源码。LangVersion 固定为 5，与 tools/build.ps1 使用的
    .NET Framework csc 一致：在这里用了 C# 6 以上的语法会直接编译失败，不会等到 Windows 上才发现。
    tools/build.ps1 只收 tests/*.cs（不递归），不会把本目录编进 PanelTests.exe。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Infrastructure -->
    <Compile Include="../../src/Infrastructure/Geometry.cs" />
    <Compile Include="../../src/Infrastructure/Log.cs" />
    <Compile Include="../../src/Infrastructure/SettingsFile.cs" />

    <!-- InsetPanel -->
    <Compile Include="../../src/Modules/InsetPanel/PanelNaming.cs" />
    <Compile Include="../../src/Modules/InsetPanel/PanelPlates.cs" />

    <!-- AutoHole Core -->
    <Compile Include="../../src/Modules/AutoHole/Core/AutoHoleData.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/AutoHolePattern.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/HoleProfile.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/HoleScan.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/HoleNaming.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/HoleSpecRead.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/HoleLink.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/HoleNativeLinkMath.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/HoleSpots.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/FaceShape.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/HoleStandard.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/HoleRules.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/PatternPresets.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/Check/HoleCheckModels.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/Check/PartRayIndex.cs" />
    <Compile Include="../../src/Modules/AutoHole/Core/Check/HoleCheck.cs" />

    <!-- FormatConvert / PropCard / BatchRename / Drawing / QuickBom -->
    <Compile Include="../../src/Modules/FormatConvert/FormatConvertCore.cs" />
    <Compile Include="../../src/Modules/PropCard/PropCardData.cs" />
    <Compile Include="../../src/Modules/BatchRename/BatchRenameData.cs" />
    <Compile Include="../../src/Modules/BatchRename/BatchRenameScan.cs" />
    <Compile Include="../../src/Modules/Drawing/DrawingPlan.cs" />
    <Compile Include="../../src/Modules/Drawing/DrawingLayout.cs" />
    <Compile Include="../../src/Modules/Drawing/DrawingTolerance.cs" />
    <Compile Include="../../src/Modules/QuickBom/BomModels.cs" />
    <Compile Include="../../src/Modules/QuickBom/BomRules.cs" />
    <Compile Include="../../src/Modules/QuickBom/BomXlsxWriter.cs" />

    <!-- Embedded Excel Templates -->
    <EmbeddedResource Include="../../src/Modules/QuickBom/Templates/ProcessingListTemplate.xlsx" LogicalName="TianGongCadSuite.QuickBom.ProcessingListTemplate.xlsx" />
    <EmbeddedResource Include="../../src/Modules/QuickBom/Templates/CodeRequestTemplate.xlsx" LogicalName="TianGongCadSuite.QuickBom.CodeRequestTemplate.xlsx" />

    <!-- Pure Test Suites -->
    <Compile Include="../AutoHolePureTests.cs" />
    <Compile Include="../HoleCheckSpeedPureTests.cs" />
    <Compile Include="../AutoHoleScanPureTests.cs" />
    <Compile Include="../AutoHoleLinkPureTests.cs" />
    <Compile Include="../FormatConvertTests.cs" />
    <Compile Include="../PanelNamingPureTests.cs" />
    <Compile Include="../PanelPlatesPureTests.cs" />
    <Compile Include="../RulesPatternPureTests.cs" />
    <Compile Include="../PropCardPureTests.cs" />
    <Compile Include="../BatchRenamePureTests.cs" />
    <Compile Include="../DrawingPlanPureTests.cs" />
    <Compile Include="../DrawingTolerancePureTests.cs" />
    <Compile Include="../QuickBomPureTests.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
  </ItemGroup>
</Project>
